{
  "buildCommand": "composer install --prefer-dist --no-interaction --node-env=production && npm install && npm run build",
  "env": {
    "APP_DEBUG": "false",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "database",
    "CACHE_DRIVER": "database",
    "DB_CONNECTION": "pgsql"
  },
  "functions": {
    "api/index.php": {
      "runtime": "php@8.3"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}